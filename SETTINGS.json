    "Dark": 1,
    "Smoke": 1,
    "Spring": 1,
    "Spike": 1,
    "Rocket":1,
    "Spin": 1,
  },

  "hunted_fruits": ["Kitsune", "Tiger"],

  "min_profit_millions": 0,
  "max_of_each_fruit_to_give": 1,
  "skip_community_voted_lose": false,

  "scan_every_minutes": 10,
  "digest_every_minutes": 30,
  "max_trades_per_email": 40,

  "alerts": [
    {
